{
  "name": "nova-ide",
  "version": "1.3.6",
  "private": true,
  "description": "Nova IDE \u2014 a full-featured desktop IDE with a built-in Chromium browser, diagram designer, git integration and an AI console powered by the Claude and Codex CLIs.",
  "author": "Nova IDE",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/byte-mods/Nova.git"
  },
  "homepage": "https://github.com/byte-mods/Nova#readme",
  "bugs": {
    "url": "https://github.com/byte-mods/Nova/issues"
  },
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "predev": "node scripts/ensure-electron.mjs",
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "test": "node tests/run.mjs",
    "test:offline": "node tests/run.mjs offline",
    "test:tools": "node tests/run.mjs tools",
    "test:ui": "node tests/verify-ui.mjs",
    "icon": "node scripts/make-icon.mjs",
    "api": "node scripts/nova-api.mjs"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@monaco-editor/react": "^4.6.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "diff": "^5.2.0",
    "dompurify": "^3.1.6",
    "js-yaml": "^4.3.1",
    "lucide-react": "^0.427.0",
    "marked": "^13.0.3",
    "mermaid": "^11.2.0",
    "monaco-editor": "^0.50.0",
    "node-pty": "^1.1.0",
    "protobufjs": "^7.6.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/diff": "^5.2.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.14",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^43.3.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "dev.nova.ide",
    "productName": "Nova",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Nova sends your camera to the people you share a session with, and only while you are broadcasting.",
        "NSMicrophoneUsageDescription": "Nova sends your microphone to the people you share a session with, and only while you are broadcasting.",
        "NSScreenCaptureUsageDescription": "Nova sends the screen or window you pick to the people you share a session with."
      }
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development"
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ]
  },
  "allowScripts": {
    "electron@43.3.0": true,
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true,
    "node-pty@1.1.0": true
  }
}
